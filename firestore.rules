rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isAdmin() { return request.auth != null && request.auth.token.email in ['flateka.com@gmail.com'] && request.auth.token.email_verified; }
    function me() { return request.auth != null ? request.auth.token.email.lower() : ''; }

    // contato do site: qualquer pessoa cria, só o admin lê
    match /leads/{id} {
      allow create: if request.resource.data.keys().hasOnly(['nome','contato','empresa','servico','msg','criado','status'])
        && request.resource.data.nome is string && request.resource.data.nome.size() < 120
        && request.resource.data.msg is string && request.resource.data.msg.size() < 2000
        && request.resource.data.status == 'novo';
      allow read, update, delete: if isAdmin();
    }
    match /clientes/{id} {
      allow read: if isAdmin() || resource.data.email == me();
      allow write: if isAdmin();
    }
    match /cobrancas/{id} {
      allow read: if isAdmin() || resource.data.clienteEmail == me();
      allow write: if isAdmin();
    }
    match /relatorios/{id} {
      allow read: if isAdmin() || resource.data.clienteEmail == me();
      allow write: if isAdmin();
    }
    // placas: qualquer um lê (a placa precisa saber o destino); o dono edita a dele; placa livre pode ser vinculada
    match /placas/{cod} {
      allow get: if true;
      allow list: if isAdmin() || (request.auth != null && resource.data.clienteEmail == me());
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (request.auth != null && resource.data.clienteEmail == me()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['titulo','tipo','destino']))
        || (request.auth != null && resource.data.clienteEmail == '' && request.resource.data.clienteEmail == me()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clienteEmail','cliente']));
    }
    // cada abertura da placa vira um acesso; ninguém edita depois
    match /acessos/{id} {
      allow create: if request.resource.data.keys().hasOnly(['codigo','clienteEmail','dia','ts'])
        && exists(/databases/$(db)/documents/placas/$(request.resource.data.codigo))
        && get(/databases/$(db)/documents/placas/$(request.resource.data.codigo)).data.clienteEmail == request.resource.data.clienteEmail;
      allow read: if isAdmin() || (request.auth != null && resource.data.clienteEmail == me());
      allow update, delete: if isAdmin();
    }
    match /recados/{id} {
      allow create: if request.resource.data.keys().hasOnly(['codigo','clienteEmail','nota','msg','nome','dia'])
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 1000
        && request.resource.data.nota is int && request.resource.data.nota >= 1 && request.resource.data.nota <= 5
        && get(/databases/$(db)/documents/placas/$(request.resource.data.codigo)).data.clienteEmail == request.resource.data.clienteEmail;
      allow read: if isAdmin() || (request.auth != null && resource.data.clienteEmail == me());
      allow delete: if isAdmin();
    }
    match /aprovacoes/{id} {
      allow read, write: if isAdmin();
    }
  }
}
